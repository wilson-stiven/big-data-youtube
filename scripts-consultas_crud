# 4. Consultas usando $expr
Likes > Comentarios
{ $expr: { $gt: ["$like_count", "$comment_count"] } }

 # Likes < Comentarios
{ $expr: { $lt: ["$like_count", "$comment_count"] } }

# Likes = Comentarios
{ $expr: { $eq: ["$like_count", "$comment_count"] } }

Ratio likes > ratio comentarios
{
  $expr: { 
    $gt: ["$likes_to_views_ratio", "$comments_to_views_ratio"] 
  }
}

# Videos con +100k vistas y más likes que comentarios
{
  $expr: { 
    $and: [
      { $gt: ["$view_count", 100000] },
      { $gt: ["$like_count", "$comment_count"] }
    ] 
  }
}

# 5. Consultas de Agregación
# 5.1 Conteo de videos por categoría
db.youtube_video.aggregate([
  { $group: { _id: "$category_id", cantidad: { $sum: 1 } } },
  { $sort: { cantidad: -1 } }
])

# Análisis

Categoría 27 es la más frecuente con 150 videos

Representa el 27.9% del dataset

Segunda categoría: 22 con 99 videos

# 5.2 Promedio de vistas por categoría
db.youtube_video.aggregate([
  { $group: { _id: "$category_id", promedio_vistas: { $avg: "$view_count" } } },
  { $project: { promedio_vistas: { $round: ["$promedio_vistas", 2] } } },
  { $sort: { promedio_vistas: -1 } }
])

# Análisis

Categoría 17 → 54.8 millones promedio

Categoría 26 → 52.7 millones promedio

# 5.3 Top 10 videos más vistos
db.youtube_video.aggregate([
  { $sort: { view_count: -1 } },
  { $limit: 10 },
  { $project: { _id: 0, Title: 1, channel_title: 1, view_count: 1, like_count: 1, comment_count: 1 } }
])

# Análisis

#1: “Making a beat with a BABY!” → 369M vistas

Contenido mayormente tipo YouTube Shorts

# 5.4 Engagement promedio por canal
db.youtube_video.aggregate([
  { $group: {
      _id: "$channel_title",
      engagement_promedio: { $avg: "$engagement_rate" },
      videos: { $sum: 1 }
  }},
  { $match: { videos: { $gte: 3 } } },
  { $sort: { engagement_promedio: -1 } },
  { $limit: 15 }
])

# Análisis

FactTechz → mayor engagement (0.0601)

Fireship → 0.0467, muy consistente

Apna College → 18 videos y alto engagement
